.{
    .identifier = "com.example.{{name}}",
    .productName = "{{name}}",
    .version = "0.1.0",
    .app = .{
        .windows = .{
            .{ .label = "main", .url = "app://localhost/index.html", .title = "{{name}}" },
        },
    },
    .security = .{
        .grants = .{"main"},
        .fuses = .{
            .allowRemoteContent = false,
            .allowEval = false,
            .allowShell = false,
            .debugInspector = false,
        },
    },
    .frontend = .{
        .dev = "npm run dev",
        .serveUrl = "http://localhost:5173",
        .build = "npm run build",
        .outDir = "dist",
    },
}
