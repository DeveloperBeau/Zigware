.{
    .identifier = "com.example.{{name}}",
    .productName = "{{name}}",
    .version = "0.1.0",
    .app = .{
        .windows = .{
            .{ .label = "main", .url = "app://localhost/index.html", .title = "{{name}}" },
        },
    },
    .security = .{
        .fuses = .{},
    },
    .frontend = .{
        .dev = "npm run dev",
        .serveUrl = "http://localhost:5173",
        .build = "npm run build",
        .outDir = "dist",
    },
}
