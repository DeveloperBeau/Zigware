.{
    .identifier = "main",
    .windows = .{"main"},
    // The dev server origin is trusted for navigation in Debug builds only; a
    // release manifest carries no devUrl origin, so the dev URL is denied at
    // runtime. app_scheme (app://) is the production origin and is always trusted.
    .origins = .{
        .app_scheme,
        .{ .devUrl = "http://localhost:5173" },
    },
}
