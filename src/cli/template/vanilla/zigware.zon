.{
    .identifier = "com.example.{{name}}",
    .productName = "{{name}}",
    .version = "0.1.0",
    .app = .{
        .windows = .{
            .{
                .label = "main",
                .url = "app://localhost/index.html",
                .title = "{{name}}",
            },
        },
    },
    .security = .{
        .capabilities = .{"main"},
        .fuses = .{
            .allowRemoteContent = false,
            .allowEval = false,
            .allowShell = false,
            .debugInspector = false,
        },
    },
    .build = .{
        .beforeDevCommand = null,
        .devUrl = null,
        .frontendDist = "frontend",
    },
}
