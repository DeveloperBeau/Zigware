.{
    .identifier = "com.zigware.crypto-vanilla",
    // productName matches the build.zig .name (the installed binary name). The
    // bundle.displayName carries the human-readable app name for the .app and
    // CFBundleExecutable; the CLI's binary-path convention uses productName.
    .productName = "crypto-vanilla",
    .version = "0.1.0",
    .bundle = .{
        .displayName = "Crypto Demo (Vanilla)",
    },
    .app = .{
        .windows = .{
            .{
                .label = "main",
                .url = "app://localhost/index.html",
                .title = "Crypto Demo (Vanilla)",
                .show = true,
            },
        },
    },
    .security = .{
        .grants = .{"main"},
        // Own scripts only, no inline JS, no remote anything: a password never
        // leaves the process, so the window trusts nothing off-origin.
        .csp = .{
            .defaultSrc = .{"'self'"},
            .scriptSrc = .{"'self'"},
        },
        .fuses = .{
            .allowRemoteContent = false,
            .allowEval = false,
            .allowShell = false,
            .debugInspector = false,
        },
    },
    .frontend = .{
        // Vanilla ships no dev server; the frontend is served as static files.
        .dev = null,
        .serveUrl = null,
        .outDir = "frontend",
    },
}
