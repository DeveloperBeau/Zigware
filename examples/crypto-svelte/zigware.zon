.{
    .identifier = "com.zigware.crypto-svelte",
    // productName matches the build.zig .name (the installed binary name). The
    // bundle.displayName carries the human-readable app name for the .app and
    // CFBundleExecutable; the CLI's binary-path convention uses productName.
    .productName = "crypto-svelte",
    .version = "0.1.0",
    .bundle = .{
        .displayName = "Crypto Demo (Svelte)",
    },
    .app = .{
        .windows = .{
            .{
                .label = "main",
                .url = "app://localhost/index.html",
                .title = "Crypto Demo (Svelte)",
            },
        },
    },
    .security = .{
        .grants = .{"main"},
        .fuses = .{
            .allowRemoteContent = false,
            .allowEval = false,
            .allowShell = false,
            .debugInspector = false,
        },
    },
    .frontend = .{
        .dev = "npm run dev",
        .serveUrl = "http://localhost:5173",
        .build = "npm run build",
        .outDir = "dist",
    },
}
