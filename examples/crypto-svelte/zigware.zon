.{
    .identifier = "com.zigware.crypto-svelte",
    .productName = "Crypto Demo (Svelte)",
    .version = "0.1.0",
    .app = .{
        .windows = .{
            .{
                .label = "main",
                .url = "app://localhost/index.html",
                .title = "Crypto Demo (Svelte)",
            },
        },
    },
    .security = .{
        .capabilities = .{"main"},
        .fuses = .{
            .allowRemoteContent = false,
            .allowEval = false,
            .allowShell = false,
            .debugInspector = false,
        },
    },
    .frontend = .{
        .dev = "npm run dev",
        .serveUrl = "http://localhost:5173",
        .build = "npm run build",
        .outDir = "dist",
    },
}
