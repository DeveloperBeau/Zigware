.{
    // In-repo runnable exe manifest (no .security.capabilities; show=true). The
    // shippable CLI manifest is zigware.zon. See crypto-vanilla for details.
    .identifier = "com.zigware.crypto-react",
    .productName = "Crypto Demo (React)",
    .version = "0.1.0",
    .app = .{
        .windows = .{
            .{ .label = "main", .title = "Crypto Demo (React)", .show = true },
        },
    },
}
