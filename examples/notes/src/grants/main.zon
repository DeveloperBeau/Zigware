.{
    .identifier = "main",
    .windows = .{"main"},
    // app_scheme (app://) is the production origin. The Vite dev-server origin is
    // trusted only in Debug builds; a release binary drops it entirely.
    .origins = .{
        .app_scheme,
        .{ .devUrl = "http://localhost:5173" },
    },
    // core:default carries compute.cancel; app:hashFile grants the hashFile
    // command scoped to $APPDATA/notes/** (the app-declared permission in the
    // runtime catalog). One capability per window keeps scopeFor at n<=1.
    .permissions = .{
        "core:default",
        "app:hashFile",
    },
}
